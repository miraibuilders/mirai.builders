onal\\\",\\\"placeholder\\\":\\\"Taro Yamada\\\",\\\"help\\\":\\\"Enter your full name.\\\"},\\\"email\\\":{\\\"label\\\":\\\"Email Address\\\",\\\"requiredLabel\\\":\\\"Required\\\",\\\"optionalLabel\\\":\\\"Optional\\\",\\\"placeholder\\\":\\\"name@example.co.jp\\\",\\\"help\\\":\\\"We will send our reply to this address.\\\"},\\\"phone\\\":{\\\"label\\\":\\\"Phone Number\\\",\\\"requiredLabel\\\":\\\"Required\\\",\\\"optionalLabel\\\":\\\"Optional\\\",\\\"placeholder\\\":\\\"03-3333-4444\\\",\\\"help\\\":\\\"10 or 11 digits, with or without hyphens.\\\"},\\\"topic\\\":{\\\"label\\\":\\\"Topic\\\",\\\"requiredLabel\\\":\\\"Required\\\",\\\"optionalLabel\\\":\\\"Optional\\\",\\\"placeholder\\\":\\\"Select a consultation topic\\\",\\\"help\\\":\\\"Choose the closest topic.\\\"},\\\"websiteUrl\\\":{\\\"label\\\":\\\"Website URL\\\",\\\"requiredLabel\\\":\\\"Required\\\",\\\"optionalLabel\\\":\\\"Optional\\\",\\\"placeholder\\\":\\\"https://example.co.jp\\\",\\\"help\\\":\\\"Target site for a health check or renewal. Leave blank if none exists yet.\\\"},\\\"message\\\":{\\\"label\\\":\\\"Details\\\",\\\"requiredLabel\\\":\\\"Required\\\",\\\"optionalLabel\\\":\\\"Optional\\\",\\\"placeholder\\\":\\\"Current website or internal workflow\\\",\\\"help\\\":\\\"Optional background or timeline, up to 1,000 characters.\\\"},\\\"consent\\\":{\\\"label\\\":\\\"Privacy Consent\\\",\\\"requiredLabel\\\":\\\"Required\\\",\\\"optionalLabel\\\":\\\"Optional\\\",\\\"placeholder\\\":\\\"\\\",\\\"help\\\":\\\"Please review and confirm before submitting.\\\"}}}},\\\"footer\\\":{\\\"eyebrow\\\":\\\"FIRST STEP\\\",\\\"title\\\":\\\"Start With a Non-Intrusive Website Check\\\",\\\"body\\\":\\\"From public-information checks to PDF quotes for web builds and system modernization, we support you directly in Japanese.\\\",\\\"ctaLabel\\\":\\\"Request a Free Consultation\\\",\\\"tagline\\\":\\\"Supporting SMBs and professional offices in Japan with passive public website checks, web builds, and modernization from spreadsheets, Access, and legacy PHP.\\\",\\\"columns\\\":[{\\\"title\\\":\\\"Services \\u0026 Guidance\\\",\\\"items\\\":[{\\\"label\\\":\\\"Challenges\\\",\\\"href\\\":\\\"/#problems\\\"},{\\\"label\\\":\\\"Services\\\",\\\"href\\\":\\\"/#services\\\"},{\\\"label\\\":\\\"Pricing\\\",\\\"href\\\":\\\"/#pricing\\\"},{\\\"label\\\":\\\"Process\\\",\\\"href\\\":\\\"/#flow\\\"},{\\\"label\\\":\\\"Company\\\",\\\"href\\\":\\\"/#company\\\"}]},{\\\"title\\\":\\\"Contact \\u0026 Information\\\",\\\"items\\\":[{\\\"label\\\":\\\"Contact\\\",\\\"href\\\":\\\"/#contact\\\"},{\\\"label\\\":\\\"Blog\\\",\\\"href\\\":\\\"/blog\\\"},{\\\"label\\\":\\\"Security Policy\\\",\\\"href\\\":\\\"/security-policy\\\"}]},{\\\"title\\\":\\\"Legal\\\",\\\"items\\\":[{\\\"label\\\":\\\"Privacy Policy\\\",\\\"href\\\":\\\"/privacy\\\"},{\\\"label\\\":\\\"Terms of Service\\\",\\\"href\\\":\\\"/terms\\\"},{\\\"label\\\":\\\"Commercial Transactions Notice\\\",\\\"href\\\":\\\"/tokushoho\\\"}]}],\\\"backToTopLabel\\\":\\\"Back to top\\\",\\\"copyright\\\":\\\"MIRAI Lab. All rights reserved. 2026\\\"},\\\"legal\\\":{\\\"privacy\\\":{\\\"slug\\\":\\\"privacy\\\",\\\"eyebrow\\\":\\\"PRIVACY POLICY\\\",\\\"title\\\":\\\"Privacy Policy\\\",\\\"description\\\":\\\"How MIRAI Lab collects, uses, protects, and handles inquiries about personal information.\\\",\\\"lead\\\":\\\"MIRAI Lab (\\\\\\\"we\\\\\\\" or \\\\\\\"us\\\\\\\") handles information responsibly when providing website health checks, web builds, and business system services.\\\",\\\"updatedLabel\\\":\\\"Last updated\\\",\\\"updatedValue\\\":\\\"November 24, 2026\\\",\\\"sections\\\":[{\\\"number\\\":\\\"01\\\",\\\"heading\\\":\\\"Information We Collect\\\",\\\"paragraphs\\\":[\\\"We handle only the information you enter in the contact form and publicly visible information obtained when checking a target site for a free health check.\\\",\\\"If you contact us by phone or email, we receive the contact details and inquiry content needed to continue the conversation.\\\"],\\\"bullets\\\":[\\\"Company or organization name, contact name, email address, and phone number\\\",\\\"Target website URL, inquiry details, preferred schedule, and budget\\\",\\\"Public information about HTTP response headers, TLS certificates, DNS email-authentication records, and publicly exposed files\\\",\\\"We do not extract or store personal names, email addresses, phone numbers, or other personal data from scanned websites.\\\"]},{\\\"number\\\":\\\"02\\\",\\\"heading\\\":\\\"How We Use Information\\\",\\\"paragraphs\\\":[\\\"We use the information only for the purposes below.\\\"],\\\"bullets\\\":[\\\"Answering inquiries, reporting health check results, and preparing quotes and proposals\\\",\\\"Issuing PDF NDAs, quotes, invoices, and acceptance documents, and handling related correspondence\\\",\\\"Improving service quality and preventing spam or other unauthorized submissions\\\"]},{\\\"number\\\":\\\"03\\\",\\\"heading\\\":\\\"Third-Party Sharing and Safeguards\\\",\\\"paragraphs\\\":[\\\"We do not disclose personal information to third parties without consent, except where required by law.\\\",\\\"Access is limited to those who need it, and we take reasonable steps to prevent loss, disclosure, and damage.\\\"]},{\\\"number\\\":\\\"04\\\",\\\"heading\\\":\\\"Retention and Deletion\\\",\\\"paragraphs\\\":[\\\"We retain information only as long as needed for the stated purposes and delete it when it is no longer necessary.\\\",\\\"To request deletion, please contact us below. We will verify your identity before responding.\\\"]},{\\\"number\\\":\\\"05\\\",\\\"heading\\\":\\\"Access, Correction, and Contact\\\",\\\"paragraphs\\\":[\\\"We respond promptly to requests for access, correction, or suspension of use after verifying identity.\\\",\\\"Contact: MIRAI Lab (Address: 1-2-3 Nihonbashi, Chuo-ku, Tokyo / Email: contact@example.jp / Phone: 03-3333-4444)\\\"]}],\\\"ctaTitle\\\":\\\"Questions About Personal Information\\\",\\\"ctaBody\\\":\\\"If you have questions about the data we handle or need an NDA, please use the contact form.\\\"},\\\"terms\\\":{\\\"slug\\\":\\\"terms\\\",\\\"eyebrow\\\":\\\"TERMS OF SERVICE\\\",\\\"title\\\":\\\"Terms of Service\\\",\\\"description\\\":\\\"Conditions for using the MIRAI Lab website, free website health checks, and related services.\\\",\\\"lead\\\":\\\"These terms govern use of the website and related services operated by MIRAI Lab (\\\\\\\"we\\\\\\\" or \\\\\\\"us\\\\\\\").\\\",\\\"updatedLabel\\\":\\\"Effective date\\\",\\\"updatedValue\\\":\\\"November 24, 2026\\\",\\\"sections\\\":[{\\\"number\\\":\\\"01\\\",\\\"heading\\\":\\\"Scope\\\",\\\"paragraphs\\\":[\\\"These terms apply to visitors and customers who request a free consultation or health check. For individual build or development engagements, the separate quote, agreement, and NDA take precedence.\\\"]},{\\\"number\\\":\\\"02\\\",\\\"heading\\\":\\\"Services and Diagnostic Scope\\\",\\\"paragraphs\\\":[\\\"The free health check is a passive first review of publicly visible information: HTTP response headers, TLS certificates, DNS email-authentication settings, and public files. We do not log in, attack, or submit forms.\\\",\\\"Checks are accepted only from the legitimate administrator of the target domain or an authorized representative.\\\"]},{\\\"number\\\":\\\"03\\\",\\\"heading\\\":\\\"Fees and Payment\\\",\\\"paragraphs\\\":[\\\"The free website health check costs nothing. Guide prices are ￥29,800 for website build and renewal, ￥98,000–￥198,000 for system modernization, and ￥30,000 / ￥60,000 / ￥100,000–￥150,000 for maintenance and support. Individual scope is set out in a written PDF quote.\\\",\\\"Payment methods and due dates are stated in the quote and invoice. Please raise any requirements in advance.\\\"]},{\\\"number\\\":\\\"04\\\",\\\"heading\\\":\\\"Prohibited Use\\\",\\\"paragraphs\\\":[\\\"Please avoid the following when using this site.\\\"],\\\"bullets\\\":[\\\"Submitting false information or inquiries while impersonating another party\\\",\\\"Unauthorized access, excessive automated submissions, scraping, or other disruptive activity\\\",\\\"Requesting checks on sites you do not administer or have permission to assess\\\"]},{\\\"number\\\":\\\"05\\\",\\\"heading\\\":\\\"Disclaimer, Governing Law, and Jurisdiction\\\",\\\"paragraphs\\\":[\\\"A passive check of public information cannot certify that no vulnerability exists. Please contact us separately if a detailed assessment is required.\\\",\\\"These terms are governed by Japanese law, and Tokyo District Court has exclusive jurisdiction as the court of first instance for any dispute.\\\"]}],\\\"ctaTitle\\\":\\\"Questions About Contract Documents\\\",\\\"ctaBody\\\":\\\"Please contact us if you need to review an NDA or individual contract terms.\\\"},\\\"tokushoho\\\":{\\\"slug\\\":\\\"tokushoho\\\",\\\"eyebrow\\\":\\\"SPECIFIED COMMERCIAL TRANSACTIONS\\\",\\\"title\\\":\\\"Specified Commercial Transactions Notice\\\",\\\"description\\\":\\\"Business details, fees, payment terms, and service timing for MIRAI Lab.\\\",\\\"lead\\\":\\\"The following information is provided in accordance with the Act on Specified Commercial Transactions.\\\",\\\"updatedLabel\\\":\\\"Last updated\\\",\\\"updatedValue\\\":\\\"November 24, 2026\\\",\\\"sections\\\":[{\\\"number\\\":\\\"01\\\",\\\"heading\\\":\\\"Business Information\\\",\\\"paragraphs\\\":[\\\"The business name is MIRAI Lab and the representative is MIRAI Lab. The office is at 1-2-3 Nihonbashi, Chuo-ku, Tokyo. Business hours are Weekdays 9:00–18:00, with phone 03-3333-4444 and email contact@example.jp.\\\"]},{\\\"number\\\":\\\"02\\\",\\\"heading\\\":\\\"Services\\\",\\\"paragraphs\\\":[\\\"We provide passive website health checks based on public information, website builds and renewals, and business system modernization.\\\"],\\\"bullets\\\":[\\\"Free Website Health Check: HTTP headers, TLS certificates, DNS email authentication, and public files\\\",\\\"Website Build \\u0026 Renewal: structure, implementation, and inquiry flows\\\",\\\"System Modernization: migration from spreadsheets, Access, and legacy PHP to web systems\\\"]},{\\\"number\\\":\\\"03\\\",\\\"heading\\\":\\\"Fees and Payment\\\",\\\"paragraphs\\\":[\\\"The free health check is Free, website build and renewal starts at ￥29,800, system modernization at ￥98,000–￥198,000, and maintenance and support at ￥30,000 / ￥60,000 / ￥100,000–￥150,000. Each engagement is quoted individually in writing.\\\",\\\"Payment method, due date, and tax treatment are stated in the quote and invoice.\\\"]},{\\\"number\\\":\\\"04\\\",\\\"heading\\\":\\\"Service Timing and Cancellation\\\",\\\"paragraphs\\\":[\\\"After agreement and scope confirmation, work proceeds and is delivered according to the schedule in the quote.\\\",\\\"If you wish to cancel or terminate mid-engagement, please contact us as soon as possible. Work already performed is handled under the terms of the quote.\\\"]}],\\\"rows\\\":[{\\\"label\\\":\\\"Business name\\\",\\\"value\\\":\\\"MIRAI Lab\\\"},{\\\"label\\\":\\\"Representative\\\",\\\"value\\\":\\\"MIRAI Lab\\\"},{\\\"label\\\":\\\"Address\\\",\\\"value\\\":\\\"1-2-3 Nihonbashi, Chuo-ku, Tokyo\\\"},{\\\"label\\\":\\\"Phone\\\",\\\"value\\\":\\\"03-3333-4444\\\"},{\\\"label\\\":\\\"Email\\\",\\\"value\\\":\\\"contact@example.jp\\\"},{\\\"label\\\":\\\"Business hours\\\",\\\"value\\\":\\\"Weekdays 9:00–18:00\\\"},{\\\"label\\\":\\\"Service area\\\",\\\"value\\\":\\\"Japan-wide remote support, Chuo-ku Tokyo\\\"},{\\\"label\\\":\\\"Services\\\",\\\"value\\\":\\\"Free Website Health Check, Website Build \\u0026 Renewal, Business System Modernization\\\"},{\\\"label\\\":\\\"Fees\\\",\\\"value\\\":\\\"Free Website Health Check: Free / Website Build \\u0026 Renewal: ￥29,800 / Business System Modernization: ￥98,000–￥198,000 / Maintenance \\u0026 Support: ￥30,000 / ￥60,000 / ￥100,000–￥150,000 (excl. tax; individual scope quoted in PDF)\\\"}],\\\"ctaTitle\\\":\\\"Document Review\\\",\\\"ctaBody\\\":\\\"Let us know during consultation which PDF documents you need for internal approval or accounting.\\\"},\\\"security-policy\\\":{\\\"slug\\\":\\\"security-policy\\\",\\\"eyebrow\\\":\\\"DIAGNOSTIC \\u0026 SECURITY POLICY\\\",\\\"title\\\":\\\"Passive Website Check \\u0026 Security Policy\\\",\\\"description\\\":\\\"What our free health check reviews, what it never does, and how collected data is handled.\\\",\\\"lead\\\":\\\"We define a strict scope for each check so you can understand your public posture without affecting production systems or daily operations.\\\",\\\"updatedLabel\\\":\\\"Policy updated\\\",\\\"updatedValue\\\":\\\"November 24, 2026\\\",\\\"sections\\\":[{\\\"number\\\":\\\"01\\\",\\\"heading\\\":\\\"Public Information We Review\\\",\\\"paragraphs\\\":[\\\"We limit review to what an ordinary browser can access and check the following public settings.\\\"],\\\"bullets\\\":[\\\"TLS certificate: expiry and baseline encryption configuration\\\",\\\"HTTP response headers: server disclosure and security-related header settings\\\",\\\"DNS email-authentication records: published SPF, DKIM, and DMARC status\\\",\\\"Publicly exposed files: whether configuration or backup files are accessible\\\"]},{\\\"number\\\":\\\"02\\\",\\\"heading\\\":\\\"What We Never Do\\\",\\\"paragraphs\\\":[\\\"To protect continuity and system safety, we never perform the following without prior agreement.\\\"],\\\"bullets\\\":[\\\"Login attempts or password guessing against admin or authentication screens\\\",\\\"Sending attack payloads or running scans that place heavy load on servers\\\",\\\"Test submissions to contact forms or modification of data\\\",\\\"Extracting or storing personal information published on scanned sites\\\"]},{\\\"number\\\":\\\"03\\\",\\\"heading\\\":\\\"Data Minimization and Handling\\\",\\\"paragraphs\\\":[\\\"We collect only the contact details and inquiry content you provide, plus the results of public-setting checks tied to the target URL.\\\",\\\"Unneeded information is deleted promptly, and access is restricted.\\\",\\\"For deeper investigation or remediation, we can execute an NDA as a PDF document.\\\"]},{\\\"number\\\":\\\"04\\\",\\\"heading\\\":\\\"Reporting and Policy Review\\\",\\\"paragraphs\\\":[\\\"Results are delivered directly to the requester as a PDF report and are not published externally.\\\",\\\"We review the check items and operating practices regularly to keep them safely scoped.\\\"]}],\\\"ctaTitle\\\":\\\"Request a Free Website Health Check\\\",\\\"ctaBody\\\":\\\"Share the target URL and we will explain how the public-information check works.\\\"}}}},\\\"children\\\":\\\"$L69\\\"},\\\"$2e\\\",\\\"$67\\\",1]\\n\"])</script><script>self.__next_f.push([1,\"6c:I[\\\"(app-pages-browser)/./src/features/landing/components/site-header.tsx\\\",[\\\"app/(marketing)/layout\\\",\\\"static/chunks/app/(marketing)/layout.js\\\"],\\\"SiteHeader\\\"]\\n7c:I[\\\"(app-pages-browser)/./src/features/landing/components/site-footer.tsx\\\",[\\\"app/(marketing)/layout\\\",\\\"static/chunks/app/(marketing)/layout.js\\\"],\\\"SiteFooter\\\"]\\n7e:I[\\\"(app-pages-browser)/./src/features/landing/components/sticky-action-bar.tsx\\\",[\\\"app/(marketing)/layout\\\",\\\"static/chunks/app/(marketing)/layout.js\\\"],\\\"StickyActionBar\\\"]\\n6a:[[\\\"MarketingLayout\\\",\\\"webpack-internal:///(rsc)/./src/app/(marketing)/layout.tsx\\\",42,94,34,1,false]]\\n6b:[[\\\"MarketingLayout\\\",\\\"webpack-internal:///(rsc)/./src/app/(marketing)/layout.tsx\\\",46,92,34,1,false]]\\n6d:[[\\\"Function.all\\\",\\\"\\\",0,0,0,0,true],[\\\"Function.all\\\",\\\"\\\",0,0,0,0,true]]\\n6e:[[\\\"Function.all\\\",\\\"\\\",0,0,0,0,true],[\\\"Function.all\\\",\\\"\\\",0,0,0,0,true]]\\n6f:[[\\\"Function.all\\\",\\\"\\\",0,0,0,0,true]]\\n71:{\\\"name\\\":\\\"NotFound\\\",\\\"key\\\":null,\\\"env\\\":\\\"Server\\\",\\\"stack\\\":[[\\\"Function.all\\\",\\\"\\\",0,